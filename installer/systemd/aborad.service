[Unit]
Description=Abora Framework daemon
Documentation=https://github.com/AboraOS-Project/Abora-Framework
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/sbin/aborad --config /etc/abora/abora.toml
Restart=on-failure
RestartSec=2

# --- Identity: an unprivileged system user, no capabilities -------------------
User=aborad
Group=aborad
AmbientCapabilities=
CapabilityBoundingSet=
NoNewPrivileges=true

# --- Directories --------------------------------------------------------------
# /var/lib/abora holds update history and tokens; /run/abora is for runtime files.
# Both are created with the right owner and are the only writable places.
StateDirectory=abora
StateDirectoryMode=0750
RuntimeDirectory=abora
RuntimeDirectoryMode=0750
ConfigurationDirectory=abora
ConfigurationDirectoryMode=0750
UMask=0077

# --- Filesystem ---------------------------------------------------------------
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/abora
PrivateTmp=true
PrivateDevices=true
# Only /proc/<pid> of its own processes, and nothing but process info in /proc.
ProtectProc=invisible
ProcSubset=pid

# --- Kernel and system --------------------------------------------------------
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

# --- Network ------------------------------------------------------------------
# The daemon only listens on loopback today, and reads systemd state over a local
# socket. Sockets for IPv4/IPv6 (loopback) and Unix are all it needs, and no other
# address is reachable. Loosen IPAddress* here when a provider needs the network.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost

# Structured logs to stderr -> journald.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
